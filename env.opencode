# Container names
OPENCODE_CONTAINER_NAME=opencode-sandbox
PROXY_CONTAINER_NAME=opencode-proxy

# Networking (fixed value, centralized here for reference)
PROXY_PORT=3128

# Host UID/GID used by userns_mode (fixed value, no clash expected in this fenced setup)
HOST_UID=59999
HOST_GID=59999

# Bind-mount paths (relative to this directory)
WORK_DIR=./work
OPENCODE_HOME_DIR=./opencode-home

# Squid log directory (default: /squidlog)
SQUIDLOG=/squidlog

# Host directory that is bind-mounted into the container at ${SQUIDLOG}
SQUIDLOG_HOST=./squid-logs
