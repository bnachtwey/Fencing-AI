# Dockerfile.proxy
FROM docker.io/library/alpine:3.20

ARG SQUID_UID=31
ARG SQUID_GID=31

# Pin squid's uid/gid so it matches the keep-id mapping in compose.
RUN set -eu; \
    apk add --no-cache squid; \
    deluser squid 2>/dev/null || true; \
    delgroup squid 2>/dev/null || true; \
    addgroup -g "${SQUID_GID}" squid; \
    adduser -S -D -H -u "${SQUID_UID}" -G squid -s /sbin/nologin squid; \
    mkdir -p /var/cache/squid /var/log/squid; \
    chown -R squid:squid /var/cache/squid /var/log/squid

COPY entrypoint-proxy.sh /usr/local/bin/entrypoint.sh
RUN chmod 755 /usr/local/bin/entrypoint.sh

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["squid", "-N", "-f", "/tmp/squid.conf"]