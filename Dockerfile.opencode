# Dockerfile.opencode
FROM docker.io/library/alpine:3.20

# Match the host user so bind mounts have sane ownership and the process has a
# real passwd entry (git, ssh and some Node tools complain otherwise).
# Pass via compose:  args: { HOST_UID: ${HOST_UID}, HOST_GID: ${HOST_GID} }
ARG HOST_UID=59999
ARG HOST_GID=59999

# Pin these for reproducible, reviewable builds.
#   OPENCODE_CODE_VERSION: e.g. 2.0.0   (default "latest" = whatever npm serves)
ARG OPENCODE_VERSION=latest
# Change this value to force a re-install when OPENCODE_VERSION stays "latest".
ARG OPENCODE_CACHEBUST=0

# Basic packages. libgcc/libstdc++/ripgrep are needed by OPENCODE Code on musl
# (compose sets USE_BUILTIN_RIPGREP=0 to use the system ripgrep).
RUN apk add --no-cache nodejs npm git bash ripgrep libgcc libstdc++ curl
RUN echo "cachebust=${OPENCODE_CACHEBUST}" \
 && npm install -g "@opencode/cli@${OPENCODE_VERSION}" \
 && npm cache clean --force \
 && opencode --version

# Create the user with the host's uid/gid. If the gid already exists in the
# image (e.g. 100 = "users"), reuse that group instead of failing.
RUN set -eu; \
    grp="$(getent group "${HOST_GID}" | cut -d: -f1 || true)"; \
    if [ -z "$grp" ]; then addgroup -g "${HOST_GID}" opencode; grp=opencode; fi; \
    adduser -D -u "${HOST_UID}" -G "$grp" -s /bin/bash opencode; \
    mkdir -p /work; \
    chown "${HOST_UID}:${HOST_GID}" /work

# Skeleton files copied into an empty $HOME at startup (see entrypoint)
RUN mkdir -p /etc/skel/.config/opencode \
 && printf '{ "autoupdate": false }\n' > /etc/skel/.config/opencode/opencode.json \
 && printf 'export PATH="$HOME/.local/bin:$PATH"\nalias ll="ls -la"\n' > /etc/skel/.bashrc \
 && printf '[ -f ~/.bashrc ] && . ~/.bashrc\n' > /etc/skel/.bash_profile

COPY entrypoint-opencode.sh /usr/local/bin/entrypoint.sh
RUN chmod 755 /usr/local/bin/entrypoint.sh

ENV HOME=/home/opencode
USER opencode
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["opencode"]
