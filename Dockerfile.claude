# Dockerfile.claude
FROM docker.io/library/alpine:3.20

# add some basic packages
RUN apk add --no-cache nodejs npm git bash ripgrep libgcc libstdc++ \
 && npm install -g @anthropic-ai/claude-code \
 && adduser -D -u 59999 -s /bin/bash claude \
 && mkdir -p /work \
 && chown claude:claude /work

# add ponytail plugin
RUN git clone --depth 1 https://github.com/DietrichGebert/ponytail /opt/ponytail \
 && chmod -R a+rx,go-w /opt/ponytail

 # Skeleton files copied into an empty $HOME at startup
RUN mkdir -p /etc/skel \
 && printf 'export PATH="$HOME/.local/bin:$PATH"\nalias ll="ls -la"\n' > /etc/skel/.bashrc \
 && printf '[ -f ~/.bashrc ] && . ~/.bashrc\n' > /etc/skel/.bash_profile \
 && mkdir -p /etc/skel/.claude

COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod a+rx,go-w /usr/local/bin/entrypoint.sh

ENV HOME=/home/claude
USER claude
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["claude"]
