# Container names (use a distinct podman-compose project, e.g. -p pi-dev)
PI_CONTAINER_NAME=pi-sandbox
PROXY_CONTAINER_NAME=pi-dev-proxy

# Networking
PROXY_PORT=3128

# Host UID/GID used by userns_mode
HOST_UID=59999
HOST_GID=59999

# Container user that Squid runs as (host user is mapped onto it via keep-id)
SQUID_UID=31
SQUID_GID=31

# Bind-mount paths (relative to this directory)
WORK_DIR=./work
PI_HOME_DIR=./pi.dev-home
SQUIDLOG_DIR=./pi.dev-squid-logs

# Squid log directory inside the proxy container
SQUIDLOG=/squid-logs

# Pin the npm release; update to a reviewed version and rebuild.
PI_VERSION=1.6.0
