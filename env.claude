# Container names
CLAUDE_CONTAINER_NAME=claude-sandbox
PROXY_CONTAINER_NAME=claude-proxy

# Networking (fixed value, centralized here for reference)
PROXY_PORT=3128

# Host UID/GID used by userns_mode
HOST_UID=59999
HOST_GID=59999

# Container user that Squid runs as (host user is mapped onto it via keep-id)
SQUID_UID=31
SQUID_GID=31

# Bind-mount paths (relative to this directory)
WORK_DIR=./work
CLAUDE_HOME_DIR=./claude-home
SQUIDLOG_DIR=./claude-squid-logs

# Squid log directory inside the proxy container
SQUIDLOG=/squid-logs
