# Container names (use a distinct podman-compose project too, e.g. -p mammouth)
MAMMOUTH_CONTAINER_NAME=mammouth-sandbox
PROXY_CONTAINER_NAME=mammouth-proxy

# Networking
PROXY_PORT=3128

# Host UID/GID used by userns_mode
HOST_UID=59999
HOST_GID=59999

# Container user that Squid runs as (host user is mapped onto it via keep-id)
SQUID_UID=31
SQUID_GID=31

# Bind-mount paths (relative to this directory)
WORK_DIR=./work
MAMMOUTH_HOME_DIR=./mammouth-home
SQUIDLOG_DIR=./mammouth-squid-logs

# Squid log directory inside the proxy container
SQUIDLOG=/squid-logs

# Mammouth Code release and target Alpine architecture (x64 or arm64).
# Pin to a reviewed release; update this value and rebuild to upgrade.
MAMMOUTH_VERSION=2.2.5
MAMMOUTH_ARCH=x64
